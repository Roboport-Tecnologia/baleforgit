# Cross-build the two release binaries (baleforgit-server + git-bale) as fully
# static x86_64-unknown-linux-musl executables. Built inside an emulated
# linux/amd64 container so targeting musl is a same-arch cross (musl-tools'
# musl-gcc targets the container's x86_64) — the standard rust-musl-builder path.
#
# Output is the binaries only, not a runnable image. Build + extract with:
#   podman build --platform linux/amd64 -f Dockerfile.x86_64-musl \
#       --target export -o type=local,dest=dist/x86_64-musl .
FROM --platform=linux/amd64 rust:1.94-bookworm AS builder
WORKDIR /src

RUN rustup target add x86_64-unknown-linux-musl \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      musl-tools musl-dev cmake clang libclang-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*

# aws-lc-sys (pulled in via reqwest's rustls) is the one dep that needs help on
# musl: a musl-targeting C compiler, cmake to build the vendored aws-lc, and
# libclang for bindgen (musl is not one of its pre-generated bindings targets).
# The cc/cmake crates honor CC_<target>.
ENV CC_x86_64_unknown_linux_musl=musl-gcc

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Cache mounts (registry/git downloads + a target dir) persist across builds on
# this machine so reruns recompile only what changed. The target dir lives in a
# cache mount that is NOT captured in the image layer, so the binaries are
# copied out to /out in the same RUN before the export stage can read them.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build-cache \
    set -eu; \
    export CARGO_TARGET_DIR=/build-cache/musl; \
    cargo build --release --target x86_64-unknown-linux-musl \
        -p bale-server-bin -p git-bale; \
    mkdir -p /out; \
    cp /build-cache/musl/x86_64-unknown-linux-musl/release/baleforgit-server /out/; \
    cp /build-cache/musl/x86_64-unknown-linux-musl/release/git-bale /out/; \
    strip /out/baleforgit-server /out/git-bale

FROM scratch AS export
COPY --from=builder /out/baleforgit-server /baleforgit-server
COPY --from=builder /out/git-bale /git-bale
